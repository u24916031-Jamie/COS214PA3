digraph "Subject"
{
 // LATEX_PDF_SIZE
  bgcolor="transparent";
  edge [fontname=Helvetica,fontsize=10,labelfontname=Helvetica,labelfontsize=10];
  node [fontname=Helvetica,fontsize=10,shape=box,height=0.2,width=0.4];
  Node1 [id="Node000001",label="Subject",height=0.2,width=0.4,color="gray40", fillcolor="grey60", style="filled", fontcolor="black",tooltip="Base Subject of Observer Design pattern."];
  Node1 -> Node2 [id="edge4_Node000001_Node000002",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node2 [id="Node000002",label="Player",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classPlayer.html",tooltip="Player class that plays golf holes."];
  Node1 -> Node3 [id="edge5_Node000001_Node000003",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node3 [id="Node000003",label="PlayerObserver",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classPlayerObserver.html",tooltip="Acts as an observer to Players, and as Subject to Scoreboards."];
  Node1 -> Node4 [id="edge6_Node000001_Node000004",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node4 [id="Node000004",label="WeatherMeter",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classWeatherMeter.html",tooltip="Senses the current state of the weather."];
}
